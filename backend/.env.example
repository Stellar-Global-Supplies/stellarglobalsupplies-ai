# Neon Database
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Groq
GROQ_API_KEY=gsk_xxx

# Tavily Search (env var kept as BRAVE_API_KEY for backward compatibility)
BRAVE_API_KEY=tvly-xxx

# Gradio Image Gen (free HF space)
GRADIO_URL=https://stabilityai-stable-diffusion.hf.space

# Enterprise Data (read-only connection)
ENT_DATABASE_URL=postgresql://readonly_user:pass@your-ent-host/entdb?sslmode=require

# New Relic
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
NEW_RELIC_APP_NAME=stellar_ai

# App
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-app.onrender.com
